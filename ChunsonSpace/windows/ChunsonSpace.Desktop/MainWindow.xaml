          <Button x:Name="BottomRebuildButton" Visibility="Collapsed" Content="重建分身" Command="{Binding OneClickRebuildCommand}" ToolTip="关闭并重建受管分身；保留账号库、项目文件与 Codex 本体" Padding="12,8" FontSize="12" Height="38" Margin="0,0,10,0" />
          <Button x:Name="BottomLaunchButton" Content="{Binding HomeLaunchLabel}" Command="{Binding HomeLaunchCommand}" ToolTip="{Binding HomeLaunchTarget}" Style="{StaticResource PrimaryButton}" Padding="22,8" FontSize="13" Height="38" />
        </StackPanel>
      </Grid>
    </Border>
    <local:ResultsGallery x:Name="ResultsPage" Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" Margin="20,14,20,14" Background="{DynamicResource CanvasBrush}" DataContext="{Binding ResultsGallery}" Visibility="{Binding DataContext.IsResultsPage,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource BoolVisibility}}"/>
    <Grid Grid.RowSpan="4" Background="{DynamicResource DetailScrimBrush}" Visibility="{Binding IsDetailOpen,Converter={StaticResource BoolVisibility}}" Grid.ColumnSpan="2" KeyboardNavigation.TabNavigation="Cycle">
      <Border x:Name="AccountManagementPanel" Width="800" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" CornerRadius="12" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
