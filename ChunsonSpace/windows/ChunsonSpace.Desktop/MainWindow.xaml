              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Grid>
      <Grid Visibility="{Binding DataContext.IsProxyPage,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource BoolVisibility}}" DataContext="{Binding ProxyPanel}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="RefreshProxyConfigButton" Content="刷新配置" Command="{Binding InspectCommand}" FontSize="12" Padding="9,6" Margin="0,0,8,0" ToolTip="只读重新识别客户端和全部订阅配置，不检测节点或修改网络。"/>
            <Button x:Name="NetworkIpButton" Content="可用 IP" Command="{Binding NodeTesting.OpenCommand}" FontSize="12" Padding="9,6" Margin="0,0,12,0" ToolTip="全部订阅的 IP、类型标签与分数；补测新增或未成功的节点"/>
            <CheckBox x:Name="ProxySimpleAdvancedToggle" Content="高级设置" IsChecked="False" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="网络与 IP" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="统一配置所有订阅的 DNS，在这里筛选和管理可用 IP。" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
          </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" x:Name="SimpleProxyPanel">
          <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsChecked,ElementName=ProxySimpleAdvancedToggle}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
          <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="16">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock Text="FlClash 网络" FontSize="16" FontWeight="SemiBold" />
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,10"><StackPanel>
                <TextBlock Text="{Binding Client}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ReadStatus}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding ApplicationDiscoveryText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,16,0,0"><TextBlock Text="无需选择 IP 或填写端口。目录和恢复操作在高级设置。" FontSize="12" Foreground="{DynamicResource MutedBrush}" /></Border>
              </StackPanel></ScrollViewer>
              <StackPanel Grid.Row="2">
                <Border Background="{DynamicResource InfoSurfaceBrush}" CornerRadius="9" Padding="12" Margin="0,0,0,12"><StackPanel>
                  <TextBlock Text="覆盖全部订阅" FontWeight="SemiBold" FontSize="13" />
                  <TextBlock Text="保留每个订阅的节点和分流。新增订阅后，再点一次即可补齐 DNS。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" />
                </StackPanel></Border>
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock Text="配置结果" FontSize="16" FontWeight="SemiBold" />
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,12"><StackPanel>
                <TextBlock x:Name="SimpleProxyResultText" Text="{Binding Status}" FontSize="12" />
                <Border Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,14,0,0"><StackPanel>
                  <TextBlock Text="{Binding DnsStage}" FontSize="12" />
                  <TextBlock Text="加密 DNS · 关闭系统 DNS 追加 · TUN DNS 接管" FontSize="12" Margin="0,7,0,0" />
                  <TextBlock Text="实际网络效果需要检测确认。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,0" />
                </StackPanel></Border>
              </StackPanel></ScrollViewer>
              <StackPanel Grid.Row="2">
                <TextBlock Text="配置前自动备份，完成后重启 FlClash。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" />
                <Button x:Name="SimpleProxySetupButton" Content="配置 FlClash 网络" Command="{Binding ConfigureNetworkCommand}" Style="{StaticResource PrimaryButton}" Height="38" FontSize="12" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
        <Grid Grid.Row="1" x:Name="AdvancedProxyPanel">
          <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsChecked,ElementName=ProxySimpleAdvancedToggle}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel IsEnabled="{Binding CanEdit}">
                <TextBlock Text="客户端" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding Client}" AutomationProperties.Name="代理客户端" Padding="7,5" FontSize="12" />
                <TextBlock Text="{Binding ReadStatus}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding ReadStatus}" />
                <TextBlock Text="代理分组 · 自动读取" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,4" />
                <ComboBox x:Name="ProxyGroupBox" ItemsSource="{Binding Groups}" DisplayMemberPath="Name" SelectedValuePath="Name" SelectedValue="{Binding ProxyGroup}" AutomationProperties.Name="代理分组" IsEnabled="{Binding HasGroups}" Padding="7,5" FontSize="12" />
                <TextBlock Text="{Binding GroupHint}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding GroupHint}" />
                <CheckBox Content="启用 TUN 自动路由" IsChecked="{Binding EnableTun}" Visibility="{Binding IsClashVerge,Converter={StaticResource BoolVisibility}}" FontSize="12" Margin="0,5,0,0" />
              </StackPanel>
              <StackPanel Grid.Row="1" Margin="0,9,0,0">
                <Expander Header="目录与程序位置" IsExpanded="False" Margin="0,0,0,8" FontSize="12" Foreground="{DynamicResource InkBrush}" x:Name="ProxyAdvancedToggle"></Expander>
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,8" />
                <WrapPanel>
                  <Button Content="查看变更" Command="{Binding PreviewCommand}" FontSize="12" Padding="9,5" Margin="0,0,6,6" />
                  <Button Content="下载 FlClash" Command="{Binding DownloadFlClashCommand}" FontSize="12" Padding="8,5" Margin="0,0,0,6" />
                </WrapPanel>
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
            <Grid>
              <Grid>
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsExpanded,ElementName=ProxyAdvancedToggle}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <TextBlock Text="配置预览" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Status}" FontSize="12" Margin="0,12,0,14" />
                    <Border Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,14">
                      <StackPanel>
                        <TextBlock Text="{Binding DnsStage}" FontSize="12" />
                        <TextBlock Text="{Binding ProtectionStage}" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding BrowserStage}" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock Text="实际业务验证：尚未验证 DNS 解析、代理出口或直连拦截。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
                      </StackPanel>
                    </Border>
                    <TextBlock Text="HTTP / mixed 端口" Style="{StaticResource FieldLabel}" />
                    <ItemsControl ItemsSource="{Binding Ports}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                            <StackPanel>
                              <TextBlock Text="{Binding Address}" FontSize="12" />
                              <TextBlock Text="{Binding Source}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="预览变更" Style="{StaticResource FieldLabel}" />
                    <ItemsControl ItemsSource="{Binding Changes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="0,8,0,5">
                            <TextBlock Text="{Binding Setting}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,16,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
                <StackPanel Visibility="{Binding IsClashVerge,Converter={StaticResource BoolVisibility}}" Grid.Row="1" Margin="0,6,0,0">
                  <TextBlock Text="导出全局脚本到新文件" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding ExportPath,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="导出全局脚本到新文件" IsEnabled="{Binding CanEdit}" Padding="6,4" FontSize="12" />
                    <Button Content="导出脚本" Command="{Binding ExportReportCommand}" HorizontalAlignment="Left" Margin="6,0,0,0" Grid.Column="1" Padding="9,5" FontSize="12" />
                  </Grid>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,7,0,0">
                  <TextBlock Text="备份目录（恢复时指定已有备份）" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                  <TextBox Text="{Binding BackupPath,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="恢复备份目录" IsEnabled="{Binding CanEdit}" Padding="6,4" FontSize="12" />
                </StackPanel>
              </Grid>
              <StackPanel Margin="0" x:Name="ProxyAdvancedPathsPanel" IsEnabled="{Binding CanEdit}">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsExpanded,ElementName=ProxyAdvancedToggle}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Margin="0,0,0,16">
                  <TextBlock Text="高级路径" FontSize="20" FontWeight="SemiBold" />
                  <TextBlock Text="再次点击左侧“目录与程序位置”可返回配置预览。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" />
                </StackPanel>
                <TextBlock Text="数据目录" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Text="{Binding DataRoot,UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="代理数据目录" Padding="10,7" FontSize="12" />
                  <Button Grid.Column="1" Content="浏览…" Click="BrowseProxyDataDirectory" AutomationProperties.Name="浏览代理数据目录" Padding="12,7" FontSize="12" Margin="8,0,0,0" />
                </Grid>
                <StackPanel Visibility="{Binding IsFlClash,Converter={StaticResource BoolVisibility}}" Margin="0,16,0,0">
                  <TextBlock Text="FlClash 应用位置" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ProxyApplicationBox" ItemsSource="{Binding ApplicationCandidates}" IsEditable="True" Text="{Binding ApplicationPath,UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="FlClash 应用位置" Padding="10,7" FontSize="12" ToolTip="{Binding ApplicationDiscoveryText}" />
                    <Button Grid.Column="1" Content="浏览…" Click="BrowseFlClashApplication" AutomationProperties.Name="浏览 FlClash 应用" Padding="12,7" FontSize="12" Margin="8,0,0,0" />
                  </Grid>
                </StackPanel>
                <TextBlock xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Text="{Binding ApplicationDiscoveryText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsChecked,ElementName=ProxySimpleAdvancedToggle}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <Button Content="恢复 DNS 备份" Command="{Binding RestoreCommand}" FontSize="12" Padding="10,6" Margin="0,0,8,0" />
            <Button Content="应用 DNS 预览" Command="{Binding ApplyCommand}" FontSize="12" Padding="10,6" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Grid.Column="1" Visibility="{Binding ShowOperationFeedback,Converter={StaticResource BoolVisibility}}" Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{Binding FeedbackAccent}" BorderThickness="3,0,0,0" Margin="20,0,20,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="FeedbackCopyErrorButton" Grid.Column="1" Content="复制错误信息" Click="CopyErrorReport" Tag="{Binding FeedbackErrorReport}" Visibility="{Binding IsError,Converter={StaticResource BoolVisibility}}" FontSize="12" Padding="8,4" Margin="10,0,0,0" VerticalAlignment="Top" ToolTip="复制脱敏诊断后，可粘贴给维护者排查"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Visibility="{Binding IsExpandedFeedback,Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="{Binding FeedbackTitle}" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Feedback}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding FeedbackNextAction}" Visibility="{Binding HasFeedbackNextAction,Converter={StaticResource BoolVisibility}}" FontSize="12" Foreground="{DynamicResource InkBrush}" Margin="0,5,0,0" />
          </StackPanel>
        </ScrollViewer>
        <TextBlock xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Text="{Binding CompactFeedbackText}" Visibility="{Binding IsCompactFeedback,Converter={StaticResource BoolVisibility}}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
      </Grid>
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Padding" Value="16,11" />
          <Setter Property="MaxHeight" Value="85" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsCompactFeedback}" Value="True">
              <Setter Property="Padding" Value="12,7" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
    </Border>
    <Border x:Name="ActiveOperationBar" Grid.Row="3" Grid.ColumnSpan="2" Visibility="{Binding IsWorkspacePage,Converter={StaticResource BoolVisibility}}" Background="{DynamicResource PlayerBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,10">
      <Grid x:Name="BottomOperationBar">
        <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
          <TextBlock Text="{Binding ActiveLabel}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding ActiveLabel}" />
          <TextBlock Text="{Binding HomeLaunchTarget}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,4,0,0" ToolTip="{Binding HomeLaunchTarget}" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
          <TextBlock Text="运行状态" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
          <TextBlock Text="{Binding RunningLabel}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding RunningLabel}" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BottomSaveCurrentButton" Content="保存当前" Command="{Binding SaveCurrentAccountCommand}" Visibility="{Binding CanSaveCurrentArchive,Converter={StaticResource BoolVisibility}}" ToolTip="先关闭客户端，再保存当前档案" Padding="12,8" FontSize="12" Height="38" Margin="0,0,10,0" />
