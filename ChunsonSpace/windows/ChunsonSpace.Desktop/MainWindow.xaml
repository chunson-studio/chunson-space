                      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="移入归档" /><Style.Triggers><DataTrigger Binding="{Binding IsAccountsPage}" Value="True"><Setter Property="Content" Value="删除账号…" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                  </WrapPanel>
                </StackPanel>
              </Grid>
            </StackPanel>
          <Button x:Name="AccountDetailCloseButton" Content="×" Command="{Binding CloseDetailsCommand}" AutomationProperties.Name="关闭账号管理" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,-10,0" Padding="10,3" MinWidth="32" MinHeight="32" FontSize="20" Style="{StaticResource QuietButton}" />
          <Border x:Name="AccountInfoCard" Grid.Row="1" Background="{DynamicResource ElevatedBrush}" CornerRadius="8" Padding="16,12,16,16" Margin="0,0,0,18" Visibility="{Binding HasSelection,Converter={StaticResource BoolVisibility}}">
            <ScrollViewer x:Name="IdentityInfoScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MaxHeight="190">
              <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}}">
                <Border Margin="0,0,0,4">
                  <TextBlock Text="{Binding EnvironmentSummary}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
