                  <TextBlock Text="{Binding InstallationDetails}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                </ScrollViewer>
                <WrapPanel Grid.Row="2">
                  <Button Content="检查安装状态" Command="{Binding InspectInstallationCommand}" FontSize="12" Padding="9,6" Margin="0,0,6,0" />
