<Window x:Class="ChunsonSpace.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ChunsonSpace.Desktop" xmlns:accounts="clr-namespace:ChunsonSpace.Accounts;assembly=ChunsonSpace.Accounts" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Chunson Space" Width="1280" Height="850" MinWidth="1040" MinHeight="670" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}" FontFamily="{StaticResource AppFont}" FontSize="13" WindowStartupLocation="CenterScreen" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <local:IdentityStatusConverter x:Key="IdentityStatus" />
    <local:EffortLabelConverter x:Key="EffortLabel" />
    <DataTemplate x:Key="EffortChoice"><TextBlock Text="{Binding Converter={StaticResource EffortLabel}}"/></DataTemplate>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style x:Key="RowManageButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Height" Value="46" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="NavFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavFrame" Property="Background" Value="{DynamicResource ElevatedBrush}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccountMenuItem" TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="MenuFrame" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuFrame" Property="Background" Value="{DynamicResource SelectionBrush}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccountContextMenu" TargetType="ContextMenu">
      <EventSetter Event="Opened" Handler="RefreshAccountMenuTheme" />
    </Style>
    <Style x:Key="AccountRowStyle" TargetType="ListBoxItem">
      <EventSetter Event="PreviewMouseRightButtonDown" Handler="SelectAccountForContextMenu" />
      <EventSetter Event="ContextMenuOpening" Handler="OpenAccountContextMenu" />
      <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
      <Setter Property="ContextMenu">
        <Setter.Value>
          <ContextMenu Style="{StaticResource AccountContextMenu}" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}" FontFamily="{StaticResource AppFont}" FontSize="12" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource InkBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" Padding="5" MinWidth="184">
            <ContextMenu.Template>
              <ControlTemplate TargetType="ContextMenu">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ItemsPresenter /></Border>
              </ControlTemplate>
            </ContextMenu.Template>
            <MenuItem Style="{StaticResource AccountMenuItem}" Header="切换并启动" Command="{Binding HomeLaunchCommand}" />
            <MenuItem Style="{StaticResource AccountMenuItem}" Header="账号配置" Command="{Binding EditSelectedCommand}" />
            <MenuItem Style="{StaticResource AccountMenuItem}" Header="重命名" Command="{Binding RenameSelectedCommand}" ToolTip="正在使用的账号需先切换到其他账号再重命名。" ToolTipService.ShowOnDisabled="True" />
            <MenuItem Style="{StaticResource AccountMenuItem}" Header="{Binding TestFreezeLabel}" Command="{Binding ToggleTestFreezeCommand}" ToolTip="冻结后跳过所有模型测试；若测试进行中，请先取消并等待结束。" ToolTipService.ShowOnDisabled="True"/>
            <Separator Margin="4,4"><Separator.Template><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource LineBrush}" /></ControlTemplate></Separator.Template></Separator>
            <MenuItem Style="{StaticResource AccountMenuItem}" Header="删除账号…" Command="{Binding ArchiveSelectedCommand}" ToolTip="删除本地账号档案并保留可恢复归档；正在使用的账号需先切换。" ToolTipService.ShowOnDisabled="True" />
          </ContextMenu>
        </Setter.Value>
      </Setter>
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Frame" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Background="Transparent" Padding="10,0">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ElevatedBrush}" /></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SelectionBrush}" />
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Frame" Property="BorderThickness" Value="3,0,0,1" />
                <Setter TargetName="Frame" Property="Padding" Value="7,0,10,0" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource ThemedCheckBox}">
      <Setter Property="Margin" Value="0,6" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,10,8" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Frame" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SelectionBrush}" />
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusOutlineBrush}" />
                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                <Setter TargetName="Frame" Property="Padding" Value="11" />
              </Trigger>
              <MultiTrigger xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True" />
                  <Condition Property="IsSelected" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource HoverOutlineBrush}" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="RootLayout" Background="{DynamicResource CanvasBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="184" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="34" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="72" />
    </Grid.RowDefinitions>
    <Border Grid.RowSpan="4" Grid.ColumnSpan="2" Background="{DynamicResource AmbientBrush}" IsHitTestVisible="False" />
    <Border x:Name="WindowTitleControls" Panel.ZIndex="100" Grid.Column="1" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock Text="预览" Visibility="{Binding IsPreview, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button x:Name="MinimizeButton" Content="—" Click="MinimizeWindow" ToolTip="最小化" AutomationProperties.Name="最小化" shell:WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent" BorderThickness="0" Padding="18,0" Height="32" MinHeight="0" />
        <Button x:Name="MaximizeButton" Content="□" Click="ToggleMaximize" ToolTip="最大化 / 还原" AutomationProperties.Name="最大化 / 还原" shell:WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent" BorderThickness="0" Padding="18,0" Height="32" MinHeight="0" />
        <Button x:Name="CloseButton" Content="×" Click="CloseWindow" ToolTip="关闭窗口" AutomationProperties.Name="关闭窗口" shell:WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent" BorderThickness="0" Padding="18,0" Height="32" MinHeight="0" FontSize="20" />
      </StackPanel>
    </Border>
    <Border x:Name="SidebarNavigation" Grid.RowSpan="3" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0" Padding="9,0,9,18">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="88" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Image Source="{StaticResource BrandMark}" Width="42" Height="42" Margin="0,0,11,0" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Chunson" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Space" FontSize="18" FontWeight="SemiBold" />
          </StackPanel>
        </StackPanel>
        <ScrollViewer x:Name="NavigationScroll" Grid.Row="1" Margin="0,7,0,6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
        <StackPanel>
          <Button x:Name="NavAccounts" Command="{Binding NavigateCommand}" CommandParameter="Accounts">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsAccountsPage}" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="Padding" Value="11,9" /></DataTrigger></Style.Triggers></Style></Button.Style>
            <StackPanel Orientation="Horizontal"><Path Style="{StaticResource LineIcon}" Data="M2,10 L10,3 18,10 M4,9 V18 H8 V12 H12 V18 H16 V9" Margin="0,0,14,0" /><TextBlock Text="账号首页" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button x:Name="NavProxy" Command="{Binding NavigateCommand}" CommandParameter="Proxy">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsProxyPage}" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="Padding" Value="11,9" /></DataTrigger></Style.Triggers></Style></Button.Style>
            <StackPanel Orientation="Horizontal"><Path Style="{StaticResource LineIcon}" Data="M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 M2,10 H18 M10,2 C5,6 5,14 10,18 M10,2 C15,6 15,14 10,18" Margin="0,0,14,0" /><TextBlock Text="网络与 IP" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button x:Name="NavModels" Command="{Binding OpenModelTestCommand}">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}" /></Button.Style>
            <StackPanel Orientation="Horizontal"><Path Style="{StaticResource LineIcon}" Data="M10,2 L18,6 V15 L10,19 2,15 V6 Z M2,6 L10,10 18,6 M10,10 V19" Margin="0,0,14,0" /><TextBlock Text="模型测试" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button x:Name="NavResults" Command="{Binding NavigateCommand}" CommandParameter="Results">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsResultsPage}" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="3,0,0,0"/></DataTrigger></Style.Triggers></Style></Button.Style>
            <StackPanel Orientation="Horizontal"><Path Style="{StaticResource LineIcon}" Data="M2,3 H18 V17 H2 Z M3,14 L7,9 11,13 14,8 18,14 M6,6 H7" Margin="0,0,14,0"/><TextBlock Text="测试结果" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <TextBlock Text="工具" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="14,12,0,8" />
          <Button x:Name="NavBackups" Command="{Binding NavigateCommand}" CommandParameter="Backups">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsBackupsPage}" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="Padding" Value="11,9" /></DataTrigger></Style.Triggers></Style></Button.Style>
            <StackPanel Orientation="Horizontal"><Path Style="{StaticResource LineIcon}" Data="M3,5 C3,1 17,1 17,5 C17,9 3,9 3,5 M3,5 V15 C3,19 17,19 17,15 V5 M3,10 C3,14 17,14 17,10" Margin="0,0,14,0" /><TextBlock Text="备份与恢复" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button x:Name="NavSettings" Command="{Binding NavigateCommand}" CommandParameter="Settings">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSettingsPage}" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="Padding" Value="11,9" /></DataTrigger></Style.Triggers></Style></Button.Style>
            <StackPanel Orientation="Horizontal"><Path Style="{StaticResource LineIcon}" Data="M8,2 H12 L13,5 16,6 18,8 V12 L15,13 14,16 12,18 H8 L7,15 4,14 2,12 V8 L5,7 6,4 Z M10,6 A4,4 0 1 0 10,14 A4,4 0 1 0 10,6" Margin="0,0,14,0" /><TextBlock Text="环境设置" VerticalAlignment="Center" /></StackPanel>
          </Button>
        </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="17,0,12,0">
          <Button x:Name="BackgroundModelButton" Command="{Binding OpenBackgroundModelCommand}" Visibility="{Binding HasBackgroundModel,Converter={StaticResource BoolVisibility}}" HorizontalContentAlignment="Stretch" Padding="8,7" Margin="0,0,0,6" ToolTip="{Binding BackgroundModelStatus}">
            <StackPanel><TextBlock Text="{Binding BackgroundModelTitle}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding BackgroundModelStatus}" FontSize="10" TextWrapping="Wrap" MaxHeight="72" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
          </Button>
          <Button x:Name="BackgroundIpButton" DataContext="{Binding ProxyPanel.NodeTesting}" Command="{Binding OpenCommand}" Visibility="{Binding HasBackgroundTask,Converter={StaticResource BoolVisibility}}" HorizontalContentAlignment="Stretch" Padding="8,7" Margin="0,0,0,10" ToolTip="{Binding Status}">
            <StackPanel><TextBlock Text="{Binding BackgroundTitle}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
          </Button>
          <Button x:Name="ShowClockButton" Content="北京时间" Command="{Binding ShowClockCommand}" FontSize="12" Padding="8,5" Margin="0,0,0,8" ToolTip="显示内置任务栏时钟，不修改系统时区" />
          <TextBlock Text="by chunson" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
          <TextBlock Text="{Binding WorkspaceBadge}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" ToolTip="{Binding TrayDescription}" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="WorkspaceContent" Grid.Row="1" Grid.Column="1" Margin="20,14,20,14">
      <Grid Visibility="{Binding IsIdentityPage,Converter={StaticResource BoolVisibility}}">
        <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="HomeTitleBar" Margin="0,0,0,10">
          <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="30" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding HomeSummary}" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
            <TextBlock x:Name="LocalEnvironmentStatusText" Text="{Binding LocalEnvironmentStatus}" ToolTip="{Binding LocalEnvironmentDetail}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="16,1,0,0" TextTrimming="CharacterEllipsis" MaxWidth="210" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsAccountsPage,Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center">
            <Button x:Name="ImportLocalAccountButton" Content="导入本机账号" Command="{Binding ImportLocalAccountCommand}" Height="32" MinHeight="32" FontSize="12" Padding="12,4" Margin="0,0,8,0" ToolTip="复制本机 Codex 已保存的授权，无需重新登录；导入后可选择账号进行模型测试" />
            <Button x:Name="AddAccountLoginButton" Content="＋  添加账号" Command="{Binding NewAccountLoginCommand}" Style="{StaticResource PrimaryButton}" Height="32" MinHeight="32" FontSize="12" Padding="12,4" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button x:Name="HomeRecheckEnvironmentButton" Content="{Binding LocalEnvironmentCheckLabel}" Command="{Binding RecheckLocalEnvironmentCommand}" ToolTip="只查询本机当前出口与时区，不测分、不修改配置；详情可悬停状态文字或到环境设置查看" Height="26" MinHeight="26" FontSize="11" Padding="8,2" Margin="0,0,8,0" Style="{StaticResource QuietButton}" />
            <Button x:Name="HomeSyncTimezoneButton" Click="OpenRegionSettings" Content="地区与时区设置" Command="{Binding NavigateCommand}" CommandParameter="Settings" ToolTip="前往环境设置；同步 Windows 地区与时区需在设置中明确点击" Height="26" MinHeight="26" FontSize="11" Padding="8,2" Style="{StaticResource QuietButton}" />
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" x:Name="WorkspaceBody">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="{Binding HomeDetailWidth}" /></Grid.ColumnDefinitions>
          <local:BotanicalGarden x:Name="HomeGarden" Grid.ColumnSpan="3" />
          <Grid Panel.ZIndex="1">
            <Grid.RowDefinitions><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Border x:Name="AccountTablePanel" VerticalAlignment="Stretch" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12">
            <Grid Margin="0,0,0,6">
              <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="Auto" /><RowDefinition Height="32" /><RowDefinition Height="*" /><RowDefinition Height="36" /></Grid.RowDefinitions>
              <Grid Margin="12,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="130" /><ColumnDefinition Width="8" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" Background="{DynamicResource ElevatedBrush}" CornerRadius="7" Padding="10,0" Height="36">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Path Style="{StaticResource LineIcon}" Data="M8,2 A6,6 0 1 0 8,14 A6,6 0 1 0 8,2 M13,13 L19,19" Width="17" Height="17" />
                    <TextBlock Grid.Column="1" Text="搜索账号" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" VerticalAlignment="Center">
                      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="SearchBox" IsEnabled="{Binding CanSelectIdentity}" Grid.Column="1" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" ToolTip="搜索 · Ctrl+F" AutomationProperties.Name="搜索档案" AutomationProperties.AcceleratorKey="Ctrl+F" Padding="0" MinHeight="0" VerticalContentAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <ComboBox x:Name="AccountFilterBox" IsEnabled="{Binding CanSelectIdentity}" Grid.Column="2" ItemsSource="{Binding AccountFilterChoices}" SelectedItem="{Binding AccountFilter}" AutomationProperties.Name="筛选账号" Padding="10,5" Height="36" FontSize="12" VerticalAlignment="Center" />
                <Button x:Name="AccountRefreshButton" Grid.Column="4" Command="{Binding RefreshCommand}" ToolTip="刷新档案 · F5" AutomationProperties.Name="刷新档案" AutomationProperties.AcceleratorKey="F5" Height="36" Padding="8">
                  <Path Style="{StaticResource LineIcon}" Data="M17,5 A8,8 0 1 0 18,12 M17,1 V6 H12" Width="18" Height="18" />
                </Button>
              </Grid>
              <Border x:Name="HomeLoginStrip" Grid.Row="1" Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,1" Padding="12,6">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsLoggingIn}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsDetailOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <DockPanel>
                  <Button x:Name="HomeCancelLoginButton" Content="取消登录" Command="{Binding CancelLoginCommand}" DockPanel.Dock="Right" FontSize="12" MinHeight="28" Height="28" Padding="8,3" />
                  <Button x:Name="HomeResumeLoginButton" Content="{Binding LoginContinueLabel}" Command="{Binding ResumeLoginCommand}" DockPanel.Dock="Right" FontSize="12" MinHeight="28" Height="28" Padding="8,3" Margin="0,0,6,0" ToolTip="{Binding LoginContinueHelp}" />
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ProgressBar IsIndeterminate="True" Width="38" Height="3" Margin="0,0,8,0" /><TextBlock Text="{Binding LoginStageLabel}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" /></StackPanel>
                </DockPanel>
              </Border>
              <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,1" Background="{DynamicResource ElevatedBrush}" Padding="10,0">
                <Grid x:Name="AccountTableHeader" VerticalAlignment="Center">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="86" /><ColumnDefinition Width="0" /><ColumnDefinition Width="94" /><ColumnDefinition Width="146" /></Grid.ColumnDefinitions>
                  <TextBlock Text="账号" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="10,0,0,0" />
                  <TextBlock Grid.Column="1" Text="出口" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                  <TextBlock Grid.Column="2" Text="端口" Visibility="Collapsed" />
                  <TextBlock Grid.Column="3" Text="状态" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                  <TextBlock Grid.Column="4" Text="操作" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" />
                </Grid>
