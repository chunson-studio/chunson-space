    </Grid>
    <Grid Grid.RowSpan="4" Grid.ColumnSpan="2" Panel.ZIndex="95" Background="{DynamicResource ScrimBrush}" KeyboardNavigation.TabNavigation="Cycle" Visibility="{Binding IsMarksEditorOpen,Converter={StaticResource BoolVisibility}}">
      <Border x:Name="AccountMarksPanel" Width="440" MaxHeight="540" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" CornerRadius="14" Padding="22" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
          <DockPanel><Button x:Name="CloseAccountMarksButton" DockPanel.Dock="Right" Content="×" Command="{Binding CloseAccountMarksCommand}" AutomationProperties.Name="关闭账号标记" Style="{StaticResource QuietButton}"/><TextBlock Text="账号标记" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
          <ScrollViewer x:Name="AccountMarksFormScroll" MaxHeight="380" VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="{Binding MarksEditor.Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding MarksEditor.Name}" Margin="0,6,0,14"/>
          <TextBlock Text="判断方式" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="AccountMarkModePicker" ItemsSource="{Binding MarksEditor.ModeChoices}" SelectedItem="{Binding MarksEditor.Mode,Mode=TwoWay}" AutomationProperties.Name="判断方式"/>
          <TextBlock Text="自动：仅根据后续完整测试判断，开启不会发请求。手动选择标记后转为手动模式。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
          <TextBlock Text="账号标记" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="AccountQualityPicker" ItemsSource="{Binding MarksEditor.QualityChoices}" SelectedItem="{Binding MarksEditor.Quality,Mode=TwoWay}" AutomationProperties.Name="账号标记选择"/>
          <TextBlock Text="绿色：账号正常　红色：账号异常" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
          <TextBlock Text="按当前测试规则判断；没读完整时保留原标记。手动模式不会被测试覆盖。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,12"/>
          <TextBlock Text="另外记录" Style="{StaticResource FieldLabel}"/>
          <CheckBox x:Name="AccountProblemCheck" Content="有问题（手动提醒）" IsChecked="{Binding MarksEditor.Problem,Mode=TwoWay}"/>
          <CheckBox x:Name="AccountRecoveredCheck" Content="已恢复（恢复历史）" IsChecked="{Binding MarksEditor.Recovered,Mode=TwoWay}"/>
          <TextBlock Text="以前不能用、后来重新能用，也可以勾选已恢复。恢复历史与当前标记分别保存。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,10"/>
          <Expander x:Name="AccountMarkDetails" Header="来源、时间与上次故障"><ScrollViewer MaxHeight="105" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding MarksEditor.Details}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/></ScrollViewer></Expander>
          </StackPanel></ScrollViewer>
          <TextBlock x:Name="AccountMarksError" Text="{Binding MarksEditor.Error}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource InkBrush}" Margin="0,8,0,8">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding MarksEditor.Error}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="ClearAccountMarksButton" Content="清除标记与恢复历史" Command="{Binding ClearAccountMarksCommand}" FontSize="12" Padding="7,6" HorizontalAlignment="Left"/>
            <Button x:Name="SaveAccountMarksButton" Grid.Column="1" Content="保存" Command="{Binding SaveAccountMarksCommand}" Style="{StaticResource PrimaryButton}" Padding="18,6"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
    <local:ArtworkViewer x:Name="ArtworkOverlay" Grid.Row="0" Grid.RowSpan="4" Grid.ColumnSpan="2" Panel.ZIndex="90" DataContext="{Binding ArtworkViewer}" Visibility="{Binding DataContext.IsArtworkOpen,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource BoolVisibility}}" KeyboardNavigation.TabNavigation="Cycle"/>
    <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Grid.RowSpan="4" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" IsHitTestVisible="False" Grid.ColumnSpan="2" />
  </Grid>
</Window>
