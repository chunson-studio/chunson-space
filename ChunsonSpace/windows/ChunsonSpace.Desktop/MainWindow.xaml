                <WrapPanel>
                  <Button x:Name="AccountLastResultButton" Content="查看上次结果" ToolTip="此账号最近一次操作的诊断，包括 IP 检测；新的 IP 检测请在首页执行" Command="{Binding OpenDiagnosticCommand}" Visibility="{Binding HasDiagnostics,Converter={StaticResource BoolVisibility}}" MinHeight="28" MinWidth="30" Padding="9,6" FontSize="12" Margin="0,0,6,6"/>
                  <Button x:Name="AccountMarksButton" Content="账号标记" Command="{Binding EditAccountMarksCommand}" MinHeight="28" Padding="9,6" FontSize="12" Margin="0,0,6,6"/>
                  <Button Content="账号配置" Command="{Binding EditSelectedCommand}" MinHeight="28" MinWidth="30" Padding="9,6" FontSize="12" Margin="0,0,6,6" ToolTip="编辑此账号的网络模式与独立 IP。"/>
                  <Button x:Name="MatchEnvironmentButton" Content="匹配账号浏览器环境" Command="{Binding ApplyDefaultsCommand}" Visibility="{Binding CanShowAccountActions,Converter={StaticResource BoolVisibility}}" MinHeight="28" MinWidth="30" Padding="9,6" FontSize="12" Margin="0,0,6,6" ToolTip="按出口更新账号档案；Windows 国家与时区在环境设置中单独配置。"/>
                </WrapPanel>
              <StackPanel Visibility="{Binding CanShowAccountActions, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="账号操作" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,8" />
                <WrapPanel>
                  <Button MinHeight="28" MinWidth="30" Content="打开档案浏览器" Command="{Binding OpenBrowserCommand}" Padding="9,6" FontSize="12" Margin="0,0,6,6" />
                  <Border BorderBrush="{DynamicResource PrimaryBrush}" Background="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="7" Margin="0,0,6,6">
                    <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Continue">
                      <Button x:Name="UsagePrimaryButton" Style="{StaticResource PrimaryButton}" Background="Transparent" Content="读取用量" Command="{Binding QuotaCommand}" AutomationProperties.Name="读取用量" BorderThickness="0" Padding="9,5" FontSize="12" MinHeight="28" ToolTip="使用已保存授权读取用量；授权过期时按原规则重试一次" />
                      <Border Width="1" Height="16" Background="{DynamicResource AccentBrush}" Opacity="0.45" VerticalAlignment="Center" />
                      <Button x:Name="UsageMenuButton" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsEnabled,ElementName=UsagePrimaryButton}" Content="▾" AutomationProperties.Name="用量与授权选项" ToolTip="用量与授权选项（向下键打开）" Padding="7,5" MinWidth="30" MinHeight="28" BorderThickness="0" Background="Transparent" Click="OpenUsageMenu" PreviewKeyDown="UsageMenuKeyDown">
                        <Button.ContextMenu>
                          <ContextMenu Style="{StaticResource AccountContextMenu}" DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}" Placement="Bottom" FontFamily="{StaticResource AppFont}" FontSize="12" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource InkBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" Padding="5" MinWidth="184">
                            <ContextMenu.Template><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="6"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" /></Border></ControlTemplate></ContextMenu.Template>
                            <MenuItem Style="{StaticResource AccountMenuItem}" Header="仅更新授权令牌" AutomationProperties.Name="仅更新授权令牌" Command="{Binding RefreshAccountCommand}" ToolTip="只更新授权令牌，不读取用量或打开网页登录" />
                          </ContextMenu>
                        </Button.ContextMenu>
                      </Button>
                    </StackPanel>
                  </Border>
                  <Button x:Name="AccountModelTestButton" MinHeight="28" MinWidth="30" Content="模型测试" Command="{Binding OpenModelTestCommand}" Padding="9,6" FontSize="12" Margin="0,0,6,6" />
                </WrapPanel>
              </StackPanel>
              <Border x:Name="DetailLoginStrip" Background="{DynamicResource InfoSurfaceBrush}" CornerRadius="6" Padding="10" Margin="0,8,0,8" Visibility="{Binding IsLoggingIn, Converter={StaticResource BoolVisibility}}">
                <DockPanel>
                  <Button MinHeight="28" MinWidth="30" Content="取消登录" Command="{Binding CancelLoginCommand}" DockPanel.Dock="Right" Padding="8,4" FontSize="12" />
                  <Button Content="{Binding LoginContinueLabel}" ToolTip="{Binding LoginContinueHelp}" Command="{Binding ResumeLoginCommand}" DockPanel.Dock="Right" MinHeight="28" Padding="8,4" FontSize="12" Margin="0,0,6,0" />
                  <TextBlock Text="{Binding LoginStageLabel}" FontSize="12" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
            </StackPanel>
          <Border Grid.Row="3" Visibility="{Binding HasSelection,Converter={StaticResource BoolVisibility}}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,10,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center"><TextBlock Text="高级维护" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="启动与关闭分身请使用首页底部操作栏" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
              <Button x:Name="SwitchButton" Grid.Column="1" Content="只切换" Command="{Binding SwitchCommand}" ToolTip="只切换账号；启动与关闭分身请返回底部操作栏" MinWidth="108" MinHeight="32" />
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.RowSpan="4" Background="{DynamicResource ScrimBrush}" KeyboardNavigation.TabNavigation="Cycle" Visibility="{Binding IsOnboardingOpen,Converter={StaticResource BoolVisibility}}" Grid.ColumnSpan="2">
      <Border Width="560" MaxHeight="600" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" CornerRadius="20" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" DataContext="{Binding Onboarding}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,18">
            <DockPanel><Image Source="{StaticResource BrandMark}" Width="38" Height="38" Margin="0,0,12,0" DockPanel.Dock="Left"/><StackPanel><TextBlock Text="登录账号" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding BrowserLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel></DockPanel>
            <TextBlock Text="选择从哪一步开始，再选择本次登录使用的网络。" Foreground="{DynamicResource MutedBrush}" Margin="0,16,0,0"/>
            <TextBlock x:Name="OnboardingStatusText" Text="{Binding Status}" FontSize="12" Margin="0,6,0,0"/>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <StackPanel IsEnabled="{Binding CanEdit}">
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12"><StackPanel>
                  <RadioButton x:Name="PrepareAccountMode" Content="先处理账号，再授权" IsChecked="{Binding PrepareAccountFirst}" GroupName="LoginStart" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Text="通过「忘记密码」重置密码，登录后退出所有设备。手动关闭浏览器并清理临时资料后，再开始授权。" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="22,6,0,12" TextWrapping="Wrap"/>
                  <RadioButton x:Name="DirectAuthorizationMode" Content="直接登录授权" IsChecked="{Binding DirectAuthorization}" GroupName="LoginStart" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Text="账号已处理好，跳过第一步，直接打开新的 Codex 授权页。" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="22,6,0,0" TextWrapping="Wrap"/>
                </StackPanel></Border>
                <Border Background="{DynamicResource InfoSurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,10"><StackPanel>
                  <RadioButton x:Name="CurrentNetworkMode" Content="沿用当前网络" IsChecked="{Binding UseCurrentNetwork}" GroupName="LoginNetwork" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Text="使用 FlClash 当前出口，TUN 模式无需配置。" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="22,7,0,0"/>
                </StackPanel></Border>
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="16"><StackPanel>
                  <RadioButton x:Name="DedicatedNetworkMode" Content="使用独立 IP" IsChecked="{Binding UseDedicatedIp}" GroupName="LoginNetwork" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Text="选择已达标的线路，自动分配端口。" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="22,7,0,0"/>
                  <StackPanel Margin="0,12,0,0" Visibility="{Binding UseDedicatedIp,Converter={StaticResource BoolVisibility}}">
                    <ComboBox x:Name="DedicatedIpPicker" ItemsSource="{Binding Pool.LoginChoices}" SelectedItem="{Binding SelectedIp}" AutomationProperties.Name="{Binding SelectedIp.ChoiceLabel}" ToolTip="{Binding SelectedIp.Result}" MaxDropDownHeight="260">
                      <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="AutomationProperties.Name"><Setter.Value><MultiBinding StringFormat="{}{0} · 订阅：{1}"><Binding Path="ChoiceLabel"/><Binding Path="Source"/></MultiBinding></Setter.Value></Setter></Style></ComboBox.ItemContainerStyle>
                      <ComboBox.ItemTemplate><DataTemplate><StackPanel>
                        <TextBlock Text="{Binding ChoiceLabel}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Source,StringFormat=订阅：{0}}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                      </StackPanel></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding SelectedIp.ChoiceExplanation}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding Pool.EmptyMessage}" Visibility="{Binding Pool.IsLoginChoicesEmpty,Converter={StaticResource BoolVisibility}}" FontSize="12" Margin="0,6,0,0"/>
                  </StackPanel>
                </StackPanel></Border>
              </StackPanel>
              <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0" Visibility="{Binding IsStarting,Converter={StaticResource BoolVisibility}}"/>
              <Border Background="{DynamicResource ErrorSurfaceBrush}" CornerRadius="10" Padding="12" Margin="0,12,0,0" Visibility="{Binding HasError,Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"/>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="通常 ≥85 分；IPEqual 住宅免评分门槛。" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
            <TextBlock Text="时区和地区随出口匹配，Windows 保持中文。" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
              <Button Content="取消" Command="{Binding CloseCommand}" Margin="0,0,10,0"/>
              <Button x:Name="OnboardingAuthorizeButton" Content="{Binding StartLabel}" Command="{Binding AuthorizeCommand}" Style="{StaticResource PrimaryButton}" MinWidth="110"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.RowSpan="4" Background="{DynamicResource ScrimBrush}" KeyboardNavigation.TabNavigation="Cycle" Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolVisibility}}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Grid.ColumnSpan="2">
      <Border Width="540" MaxHeight="620" Background="{DynamicResource CanvasBrush}" CornerRadius="14" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
        <Grid DataContext="{Binding Editor}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="EditorDescriptionText" Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="480" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,18" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <StackPanel Visibility="{Binding ShowName, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="档案名称" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="档案名称" IsEnabled="{Binding CanEditName}" Padding="10" />
              </StackPanel>
              <CheckBox Content="覆盖既有档案（覆盖前保留恢复材料）" IsChecked="{Binding Overwrite}" Visibility="{Binding ShowOverwrite, Converter={StaticResource BoolVisibility}}" />
              <TextBlock Text="{Binding Details}" Visibility="{Binding HasDetails, Converter={StaticResource BoolVisibility}}" FontSize="12" Margin="0,8,0,0" />
              <StackPanel Visibility="{Binding IsEnvironmentEditor, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanEdit}">
                <CheckBox x:Name="AccountFollowNetworkToggle" Content="跟随 FlClash 当前网络" IsChecked="{Binding FollowSystemProxy}" Margin="0,10,0,0" />
                <TextBlock Text="{Binding NetworkModeDescription}" TextWrapping="Wrap" Margin="0,4,0,10" Foreground="{DynamicResource MutedBrush}" />
                <StackPanel x:Name="AccountChangeIpSection" Visibility="{Binding ShowIpPicker,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12">
                  <DockPanel Margin="0,0,0,7">
                    <Button x:Name="AccountRandomIpButton" Content="随机换一个" Command="{Binding RandomIpCommand}" DockPanel.Dock="Right" Padding="10,6"/>
                    <TextBlock Text="更换独立 IP" VerticalAlignment="Center" FontWeight="SemiBold"/>
                  </DockPanel>
                  <ComboBox x:Name="AccountChangeIpPicker" ItemsSource="{Binding IpPool.LoginChoices}" SelectedItem="{Binding SelectedIp}" MaxDropDownHeight="220" AutomationProperties.Name="更换独立 IP">
                    <ComboBox.ItemTemplate><DataTemplate><StackPanel>
                      <TextBlock Text="{Binding ChoiceLabel}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Source,StringFormat=订阅：{0}}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="选择其他 IP 或随机换一个，保存前不会更改网络。留空保留现有独立 IP。" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
                  <TextBlock Text="暂无可选 IP，请先到「网络与 IP」筛选。" Visibility="{Binding IpPool.IsLoginChoicesEmpty,Converter={StaticResource BoolVisibility}}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel x:Name="AccountManualProxyFields" Visibility="{Binding ShowManualProxy,Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="HTTP / HTTPS 代理" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Proxy, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="HTTP / HTTPS 代理" IsEnabled="{Binding UsesDedicatedProxy}" Padding="10" />
                <TextBlock Text="从已检查的代理客户端选择端口" Style="{StaticResource FieldLabel}" />
                <ItemsControl ItemsSource="{Binding DataContext.ProxyPanel.Ports, RelativeSource={RelativeSource AncestorType=Window}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding Address}" Command="{Binding DataContext.UseProxyCandidateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Left" Padding="10,6" Margin="0,0,0,5" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
                <StackPanel Visibility="{Binding ShowManualEnvironment,Converter={StaticResource BoolVisibility}}">
                  <TextBlock Text="时区（IANA 名称，可留空）" Style="{StaticResource FieldLabel}" />
                  <TextBox Text="{Binding Timezone, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="时区（IANA 名称，可留空）" Padding="10" />
                  <TextBlock Text="界面语言（例如 zh-CN / en-US）" Style="{StaticResource FieldLabel}" />
                  <TextBox Text="{Binding Locale, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="界面语言（例如 zh-CN / en-US）" Padding="10" />
                </StackPanel>
              </StackPanel>
              <Border Background="{DynamicResource ErrorSurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,15,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource InkBrush}" FontSize="12" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="取消" Command="{Binding CancelCommand}" Margin="0,0,10,0" />
            <Button Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinWidth="90" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.RowSpan="4" Grid.ColumnSpan="2" Background="{DynamicResource ScrimBrush}" KeyboardNavigation.TabNavigation="Cycle" Visibility="{Binding IsDiagnosticOpen,Converter={StaticResource BoolVisibility}}">
      <Border Width="680" Height="530" Padding="24" CornerRadius="12" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,16"><TextBlock x:Name="AccountResultTitle" Text="{Binding DiagnosticTitle}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding DiagnosticAccount}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
          <TextBox x:Name="IpDiagnosticResult" Grid.Row="1" Text="{Binding DiagnosticDetails,Mode=OneWay}" TextChanged="DiagnosticResultChanged" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="13" Padding="12"/>
          <Button x:Name="AccountResultDoneButton" Grid.Row="2" Content="完成" Command="{Binding CloseDiagnosticCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,16,0,0"/>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.RowSpan="4" Background="{DynamicResource ScrimBrush}" KeyboardNavigation.TabNavigation="Cycle" DataContext="{Binding ProxyPanel.NodeTesting}" Visibility="{Binding IsOpen,Converter={StaticResource BoolVisibility}}" Grid.ColumnSpan="2">
      <Border Width="920" Height="600" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" CornerRadius="18" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <DockPanel>
              <Button x:Name="NodeTestingBackgroundButton" Content="收起到后台" Command="{Binding CloseCommand}" DockPanel.Dock="Right" Padding="10,5" FontSize="12" ToolTip="收起窗口，筛选继续；左下角可查看进度与结果"/>
              <TextBlock Text="可用 IP" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="自动检测 · 通常 ≥85 分，IPEqual 住宅免评分门槛 · 相同 IP 合并。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,14" ToolTip="{Binding ModeDescription}"/>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding SourceLabel}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Button x:Name="NodeScreenButton" Grid.Column="1" Content="重新检测全部" Command="{Binding LoadCommand}" Margin="0,0,10,0" ToolTip="重新检查全部候选线路的连通性和出口，仍复用已有 IP 评分。"/>
              <Button x:Name="NodeSupplementButton" Grid.Column="2" Content="补测新增与失败" Command="{Binding SupplementCommand}" Style="{StaticResource PrimaryButton}" ToolTip="读取最新订阅，只测新增、变更、超时、失败或没有分数的节点。已测出分数的节点（包括低分）会跳过。"/>
            </Grid>
            <TextBlock Text="{Binding CountLabel}" FontSize="12" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding ResultSummary}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
            <TextBlock Text="{Binding Issues}" Visibility="{Binding HasIssues,Converter={StaticResource BoolVisibility}}" FontSize="12" Foreground="{DynamicResource MutedBrush}" MaxHeight="30" Margin="0,0,0,8"/>
          </StackPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
            <ListBox x:Name="NodeTestingList" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedNode}" Style="{StaticResource ThemedListBox}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                  <Setter Property="Margin" Value="6,0,6,6"/><Setter Property="Padding" Value="0"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="NodeRowFrame" Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="10" CornerRadius="6"><ContentPresenter/></Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NodeRowFrame" Property="Background" Value="{DynamicResource ElevatedBrush}"/></Trigger>
                      <Trigger Property="IsSelected" Value="True"><Setter TargetName="NodeRowFrame" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate></Setter.Value></Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate><StackPanel>
                <DockPanel>
                  <Border DockPanel.Dock="Right" Background="{DynamicResource BadgeBrush}" CornerRadius="10" Padding="10,7" Margin="14,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding QualityScore}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="分" FontSize="12" VerticalAlignment="Bottom" Margin="4,0,0,3"/></StackPanel></Border>
                  <StackPanel><DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Right" Background="{DynamicResource InfoSurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="NodeTypeTag" Text="{Binding NetworkTag}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                    </Border>
                    <TextBlock Text="{Binding Country}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}"/>
                  </DockPanel>
                    <TextBlock Text="{Binding ExitIp}" Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
