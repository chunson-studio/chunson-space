                    <TextBlock Text="界面语言" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding Selected.Locale}" FontSize="13" TextWrapping="Wrap" ToolTip="{Binding Selected.Locale}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="15,0,0,0">
                    <TextBlock Text="时区" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding Selected.Timezone}" FontSize="13" TextWrapping="Wrap" ToolTip="{Binding Selected.Timezone}" />
                    <TextBlock Text="模型" Style="{StaticResource FieldLabel}" />
