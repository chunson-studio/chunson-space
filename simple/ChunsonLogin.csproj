<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AssemblyName>ChunsonLogin</AssemblyName>
    <RootNamespace>ChunsonLogin</RootNamespace>
    <Product>椿生登录助手</Product>
    <Version>1.3.0</Version>
    <Authors>chunson</Authors>
    <ApplicationIcon>Assets/App.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="ThirdParty/YamlDotNet/LICENSE.txt;ThirdParty/YamlDotNet/SOURCE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets/App.ico" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
  <Import Project="../taskbar-clock/Clock.targets" />
</Project>